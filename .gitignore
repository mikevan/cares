# CARES - .gitignore
# Exclude development and test artifacts from version control

# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
**/__pycache__/
**/*.pyc

# ==================== Virtual Environments ====================
venv/
ENV/
env/
.venv/

# ==================== IDEs ====================
.vscode/
.idea/
*.swp
*.swo
*~

# ==================== Database Files ====================
*.db
*.sqlite3
instance/

# ==================== Environment Files ====================
.env
.env.local
.env.*.local

# ==================== Test Artifacts (DO NOT DEPLOY) ====================
# Test coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Test reports
tests/reports/
*.html

# Test databases
test.db
*_test.db

# ==================== Build & Distribution ====================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==================== Logs ====================
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt

# ==================== OS Files ====================
.DS_Store
Thumbs.db
desktop.ini

# ==================== Temporary Files ====================
*.tmp
*.temp
*.bak
*.swp
*~

# ==================== Deployment-Specific ====================
# Keep smoke tests for production, exclude all other tests
tests/conftest.py
tests/pytest.ini
tests/__pycache__/

# Development-only scripts
run_tests.py
run_tests.bat
run_tests.sh

# Keep smoke tests - these can run in production
!tests/smoke/

# ==================== Documentation Drafts ====================
*.draft.md
*.wip.md
kofc-accounting-system.zip
scripts/create_issues.ps1
test_results.txt
tests/__pycache__/conftest.cpython-314-pytest-8.3.4.pyc
tests/functional/__pycache__/test_reports.cpython-312-pytest-8.3.4.pyc
tests/__pycache__/conftest.cpython-314-pytest-8.3.4.pyc
tests/__pycache__/conftest.cpython-314-pytest-8.3.4.pyc
tests/__pycache__/conftest.cpython-314-pytest-8.3.4.pyc
tests/reports/test_report.html
tests/functional/__pycache__/test_reports.cpython-312-pytest-8.3.4.pyc
tests/__pycache__/conftest.cpython-314-pytest-8.3.4.pyc
